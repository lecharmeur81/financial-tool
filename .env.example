# Copy this file to .env (which is git-ignored) and set real values. Never commit .env.
# Use long random passwords made of letters and digits only (they are embedded in connection URLs).
# PowerShell one-liner for a random value:  [guid]::NewGuid().ToString('N')

POSTGRES_USER=cfi
POSTGRES_PASSWORD=replace-with-a-random-value
POSTGRES_DB=cfi
REDIS_PASSWORD=replace-with-a-random-value

# Logging: INFO | DEBUG | WARNING | ERROR ; format json | console
CFI_LOG_LEVEL=INFO
CFI_LOG_FORMAT=json

# Host ports (bound to 127.0.0.1). Change if something else already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000

# Market data (Phase 5)
# Providers the background workers ingest from (comma-separated):
#   coinbase, kraken, binance, okx, bybit, coingecko
# Binance, OKX, Bybit and Kraken are blocked by Philippine ISPs (2024/2025); if they keep failing
# in provider health, remove them here.
CFI_MARKET_PROVIDERS=coinbase,kraken,binance,okx,bybit,coingecko
# Optional: history depth per timeframe in days (defaults: 1m=7,5m=30,15m=90,1h=730,4h=1460,1d=3650,
# market_cap_1d=365). Example: CFI_MARKET_BACKFILL_DAYS=1m=3,1h=365
CFI_MARKET_BACKFILL_DAYS=
# Optional free CoinGecko Demo API key (works without one, at lower limits). Never commit a real key.
CFI_PROVIDER_COINGECKO_API_KEY=

# --- Institutional capital (Phase 6) ---------------------------------------------------------
# Providers the workers ingest institutional data from (SoSoValue: US spot ETF flows for BTC, ETH,
# SOL, XRP and BTC treasury purchases; CoinGecko: listed-company holdings totals).
CFI_INSTITUTIONAL_PROVIDERS=sosovalue,coingecko
# Free SoSoValue API key (register at https://sosovalue.com/developer/dashboard and wait for
# approval). Without it, SoSoValue jobs are skipped and the Flows page says so. Never commit a key.
CFI_PROVIDER_SOSOVALUE_API_KEY=

# --- Whale intelligence (Phase 7) ------------------------------------------------------------
# Providers the workers ingest whale data from (Coin Metrics Community: exchange flows and supply
# for BTC and ETH, licence CC BY-NC 4.0; Blockchair: top-100 balances, large transfers, Bitcoin
# coin-age data — free for personal / non-commercial use up to 1,440 requests a day).
CFI_WHALE_PROVIDERS=coinmetrics,blockchair
# Optional Blockchair API key (only needed above the free limits). Never commit a real key.
CFI_PROVIDER_BLOCKCHAIR_API_KEY=

# --- Derivatives (Phase 8) ---------------------------------------------------------------------
# Providers the workers ingest derivatives data from (all public, no key): binance_futures
# (Binance USDⓈ-M open interest, funding, account ratio), okx_derivatives (OKX open interest,
# funding, account ratio, liquidations), deribit (futures curve, option chain, DVOL for BTC, ETH).
# Binance and OKX may be blocked by some ISPs; remove them here if their runs keep failing.
CFI_DERIVATIVE_PROVIDERS=binance_futures,okx_derivatives,deribit
