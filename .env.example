# Copy this file to .env (which is git-ignored) and set real values. Never commit .env.
# Use long random passwords made of letters and digits only (they are embedded in connection URLs).
# PowerShell one-liner for a random value:  [guid]::NewGuid().ToString('N')

POSTGRES_USER=cfi
POSTGRES_PASSWORD=replace-with-a-random-value
POSTGRES_DB=cfi
REDIS_PASSWORD=replace-with-a-random-value

# Logging: INFO | DEBUG | WARNING | ERROR ; format json | console
CFI_LOG_LEVEL=INFO
CFI_LOG_FORMAT=json

# Host ports (bound to 127.0.0.1). Change if something else already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000
